  "query": "\nUPDATE sessions\nSET access_hash = $2,\n    refresh_hash = $3,\n    access_expires_at = LEAST(now() + interval '15 minutes', expires_at)\nWHERE refresh_hash = $1\n    AND revoked_at IS NULL\n    AND expires_at > now()\nRETURNING user_id, access_expires_at, expires_at\n",
